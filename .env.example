# Copy to .env and fill in. .env is git-ignored.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/social

# Django (web-django/) only. Generate a value locally and never commit it:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Django (web-django/) only. Off unless set. Turn it on for local development:
# runserver serves the admin's CSS and JS only with DEBUG on.
DEBUG=0
